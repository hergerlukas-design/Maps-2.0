# ---------------------------------------------------------------------------
# Client (VITE_*)
#
# Diese Werte landen im Browser-Bundle. Nur Schlüssel hier eintragen, die
# öffentlich sein dürfen — der Mapbox-Token gehört per Domain-Beschränkung
# abgesichert, der Supabase-anon-Key ist durch Row Level Security geschützt.
# ---------------------------------------------------------------------------

# Mapbox: Karte, Routing (Directions), Adresssuche (Geocoding).
# Token unter https://account.mapbox.com/access-tokens/ erstellen und dort auf
# die eigene Domain einschränken.
VITE_MAPBOX_TOKEN=

# Optional: eigene Kartenstile. Voreinstellung ist der Mapbox-Navigationsstil.
# VITE_MAPBOX_STYLE=mapbox://styles/mapbox/navigation-night-v1
# VITE_MAPBOX_STYLE_DAY=mapbox://styles/mapbox/navigation-day-v1

# Supabase: Konten, Fahrzeugprofile, Einstellungen, Favoriten, Verlauf.
# Ohne diese Werte läuft die App vollständig ohne Konto; Einstellungen bleiben
# dann lokal auf dem Gerät.
VITE_SUPABASE_URL=
# Der neuere `sb_publishable_…`-Schlüssel ist zu bevorzugen: er lässt sich
# unabhängig rotieren. Der ältere anon-JWT wird als VITE_SUPABASE_ANON_KEY
# weiterhin akzeptiert.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: Basis-URL der API, falls Client und Server getrennt laufen.
# VITE_API_BASE=/api

# Optional: Länder für die Adresssuche.
# VITE_GEOCODING_COUNTRIES=de,at,ch

# ---------------------------------------------------------------------------
# Server
#
# Diese Werte bleiben auf dem Server. Sie NICHT mit VITE_ präfixen — sonst
# landen sie im Browser-Bundle und sind damit öffentlich.
# ---------------------------------------------------------------------------

PORT=8787
# NODE_ENV=production

# Tankerkönig: Kraftstoffpreise (Super E5, E10, Diesel).
# Kostenloser Key per Formular unter https://creativecommons.tankerkoenig.de/
# Ohne Key liefert /api/stops/fuel 503 und die App sagt das im UI.
TANKERKOENIG_API_KEY=

# GoingElectric: Ladesäulen mit Steckertyp und Leistung.
# Key formlos per Mail an die auf goingelectric.de genannte Adresse.
# Ohne Key wird automatisch Open Charge Map genutzt (geringere Datentiefe).
GOINGELECTRIC_API_KEY=

# Open Charge Map: Fallback für Ladesäulen. Funktioniert ohne Key mit
# reduziertem Kontingent; ein Key unter https://openchargemap.org/site/profile
# hebt das Limit an.
OPENCHARGEMAP_API_KEY=

# Overpass (OpenStreetMap): Rastplätze und Toiletten. Kein Key nötig.
# Bei eigener Instanz hier die URL eintragen — die öffentliche Instanz ist
# gespendete Infrastruktur und wird vom Server strikt serialisiert angefragt.
# OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter

# Web Push (VAPID). Schlüsselpaar erzeugen mit:
#   npx web-push generate-vapid-keys
# Ohne diese Werte funktionieren Hinweise innerhalb der geöffneten App weiterhin;
# nur Push bei geschlossener App entfällt.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:du@example.com

# Nur nötig, wenn der Client von einer anderen Domain als die API geladen wird.
# CORS_ORIGINS=https://reichweite.example.com
